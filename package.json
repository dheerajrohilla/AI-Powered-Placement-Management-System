{
  "name": "placement-management-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm --prefix placement-backend run dev\" \"npm --prefix placement-frontend run dev\"",
    "dev:backend": "npm --prefix placement-backend run dev",
    "dev:frontend": "npm --prefix placement-frontend run dev",
    "seed": "npm --prefix placement-backend run seed"
  },
  "dependencies": {
    "lucide-react": "^1.40.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
