# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
PORT=5000
NODE_ENV=development

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
MONGODB_URI=mongodb://localhost:27017/placement-db

# ==============================================================================
# AUTHENTICATION & SECURITY
# ==============================================================================
JWT_SECRET=your_secret_key_here_change_in_production
JWT_EXPIRE=7d

# ==============================================================================
# CORS & FRONTEND CLIENT CONFIGURATION
# ==============================================================================
CLIENT_URL=http://localhost:5173

# ==============================================================================
# CENTRALIZED EMAIL NOTIFICATION SYSTEM CONFIGURATION
# ==============================================================================
# NOTE: Email configuration is performed ONCE by the system administrator.
# Individual students, recruiters, and placement officers never configure credentials.
#
# Option A: Google Gmail (Recommended for quick campus/production deployment)
# 1. Enable 2-Step Verification in Google Account (myaccount.google.com)
# 2. Generate an App Password: Security -> 2-Step Verification -> App Passwords
# 3. Enter your Gmail and the 16-character app password below:
# SMTP_SERVICE=gmail
# SMTP_USER=placements.cell@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
#
# Option B: Dedicated SMTP Provider (SendGrid, Mailtrap, AWS SES, Brevo, Postmark)
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
#
# Sender Identity shown to recipients:
EMAIL_FROM="Training & Placement Cell" <placements@university.edu>
#
# Resilience, Timeouts & Delivery Retries
EMAIL_TIMEOUT_MS=10000
EMAIL_MAX_RETRIES=3

# ==============================================================================
# GOOGLE GEMINI AI CONFIGURATION
# ==============================================================================
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
